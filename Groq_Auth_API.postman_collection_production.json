{
    "info": {
        "name": "Groq API Production",
        "description": "Production API collection for Groq Intent Router with multi-brand support",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://groq-api-y9qo.onrender.com",
            "type": "string"
        },
        {
            "key": "sessionId",
            "value": "",
            "type": "string"
        },
        {
            "key": "lastBrandId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('sessionId', jsonData.sessionId);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Prod User\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('sessionId', jsonData.sessionId);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Brands",
            "item": [
                {
                    "name": "Create Tech Brand",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Session-Id",
                                "value": "{{sessionId}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Nexus AI\",\n    \"tagline\": \"Powering the Next Intelligence\",\n    \"description\": \"Neural Network Solutions API\",\n    \"mission\": \"To advance human potential through AI\",\n    \"vision\": \"A world where AI is seamless and helpful\",\n    \"industry\": \"Technology\",\n    \"website_url\": \"https://nexus.ai\",\n    \"logo_url\": \"https://nexus.ai/logo.png\",\n    \"logo_position\": \"Top-Left\",\n    \"primary_color\": \"#0000FF\",\n    \"secondary_color\": \"#FFFFFF\",\n    \"heading_font\": \"Inter\",\n    \"body_font\": \"Roboto\",\n    \"brand_guidelines_url\": \"https://nexus.ai/brand-book.pdf\",\n    \"date_format\": \"dd/mm/yyyy\",\n    \"brandVoice\": \"Authoritative\",\n    \"targetAudience\": \"CTOs\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/brands",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "brands"
                            ]
                        }
                    }
                },
                {
                    "name": "Get My Brands",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const brands = pm.response.json().brands;",
                                    "    if (brands.length > 0) {",
                                    "        pm.collectionVariables.set('lastBrandId', brands[0].id);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Session-Id",
                                "value": "{{sessionId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/brands",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "brands"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Intents",
            "item": [
                {
                    "name": "Route Query with Brand",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Session-Id",
                                "value": "{{sessionId}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"create a post about our new launch\",\n  \"brandId\": \"{{lastBrandId}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/route",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "route"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}