                {
                    "name": "Get My Brands",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const brands = pm.response.json().brands;",
                                    "    if (brands.length > 0) {",
                                    "        pm.collectionVariables.set('lastBrandId', brands[0].id);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Session-Id",
                                "value": "{{sessionId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/brands",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "brands"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Brand Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Session-Id",
                                "value": "{{sessionId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/brands/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "brands",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "{{lastBrandId}}"
                                }
                            ]
                        }
                    }
                },
