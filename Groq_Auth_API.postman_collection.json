                            "raw": "{\n    \"name\": \"Updated Brand Name\",\n    \"description\": \"Updated description\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/brands/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "brands",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "{{lastBrandId}}"
                                }
                            ]
