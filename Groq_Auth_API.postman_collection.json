                            "raw": "{\n  \"resetToken\": \"your-reset-token\",\n  \"newPassword\": \"newpassword123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/reset-password",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "reset-password"
                            ]
                        },
                        "description": "Reset password using token"
